{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "racera-vote-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "racera-votes",
			"database_id": "25cb6b4f-7b7f-45b5-8365-af9a7560280c",
			"migrations_dir": "migrations"
		}
	]
}
