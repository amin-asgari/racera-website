{
  "id": "/web-app/",
  "name": "Racera",
  "short_name": "Racera",
  "description": "Motorsport calendars, results, standings, profiles and session reminders.",
  "start_url": "/web-app/#/home",
  "scope": "/web-app/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#141218",
  "theme_color": "#141218",
  "categories": ["sports", "utilities"],
  "icons": [
    {
      "src": "/web-app/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    { "name": "Calendar", "url": "/web-app/#/calendar" },
    { "name": "Standings", "url": "/web-app/#/standings" }
  ]
}
